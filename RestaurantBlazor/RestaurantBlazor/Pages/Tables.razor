@page "/tables"
@layout MainLayout
@implements IAsyncDisposable
@using RestaurantBlazor.Services
@using RestaurantBlazor.Models
@inject ApiService Api
@inject IAuthService AuthService
@inject KitchenHubService HubService
@inject NavigationManager Nav

<PageTitle>Столы</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-grid-3x3-gap-fill me-2"></i>Столы и бронирования</h2>
        <div class="text-muted small">Управление залом</div>
    </div>
    @if (AuthService.GetCurrentRole() == 1)
    {
        <button class="btn btn-warning" @onclick="() => showCreateTable = true">
            <i class="bi bi-plus-lg me-1"></i>Новый стол
        </button>
    }
</div>

@if (!string.IsNullOrEmpty(waiterNotification))
{
    <div class="alert alert-info app-notice" role="status"><i class="bi bi-bell me-2"></i>@waiterNotification<button class="app-notice-close" aria-label="Закрыть" @onclick="() => waiterNotification = string.Empty">×</button></div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger app-notice" role="alert"><i class="bi bi-exclamation-circle me-2"></i>@errorMessage<button class="app-notice-close" aria-label="Закрыть" @onclick="() => errorMessage = string.Empty">×</button></div>
}
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success app-notice" role="status"><i class="bi bi-check-circle me-2"></i>@successMessage<button class="app-notice-close" aria-label="Закрыть" @onclick="() => successMessage = string.Empty">×</button></div>
}

<style>.table-plan{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));grid-auto-rows:156px;gap:16px;padding:18px;background:#e9dfcf;border-radius:12px;overflow:auto}.table-plan-item{min-width:0}</style>
<div class="table-plan mb-4" aria-label="План зала">
    @foreach (var t in tables)
    {
        <div class="table-plan-item">
            <div class="card border-0 shadow-sm h-100 position-relative @GetTableCardClass(t.Status)">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-inline-flex align-items-center justify-content-center rounded"
                             style="width:38px; height:38px; background:#fde8eb; color:#c8102e;">
                            <i class="bi bi-grid-3x3-gap-fill"></i>
                        </div>
                        <span class="badge @GetTableStatusClass(t.Status)">@GetTableStatusLabel(t.Status)</span>
                    </div>
                    <div class="fw-bold mb-0">Стол @t.Number</div>
                    <small class="text-muted">мест: @t.Capacity</small>
                    @if (AuthService.GetCurrentRole() == 1)
                    {
                        <button class="btn btn-sm btn-link text-danger p-0 mt-2 d-block" @onclick="() => DeleteTable(t.TableID)">
                            <i class="bi bi-trash me-1"></i>Удалить
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (showCreateTable)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Новый стол</h5>
                    <button type="button" class="btn-close" @onclick="() => showCreateTable = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small">Номер стола *</label>
                        <input required max="9999" class="form-control" type="number" min="1" @bind="newTable.Number" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Вместимость *</label>
                        <input required max="30" class="form-control" type="number" min="1" @bind="newTable.Capacity" />
                    </div>
                    <div class="row g-2"><div class="col-6"><label class="form-label small">Колонка на плане</label><input required class="form-control" type="number" min="1" max="6" @bind="newTable.PositionX" /></div><div class="col-6"><label class="form-label small">Ряд на плане</label><input required class="form-control" type="number" min="1" max="8" @bind="newTable.PositionY" /></div></div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showCreateTable = false">Отмена</button>
                    <button class="btn btn-warning" data-validate="true" @onclick="CreateTable">Создать</button>
                </div>
            </div>
        </div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0"><i class="bi bi-calendar-week me-2"></i>Бронирования</h6>
        <button class="btn btn-warning btn-sm" @onclick="() => showReserveModal = true">
            <i class="bi bi-plus-lg me-1"></i>Новое бронирование
        </button>
    </div>
    @if (!reservations.Any())
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-calendar-x text-muted" style="font-size:42px;"></i>
            <p class="text-muted mb-0 mt-2">Бронирований нет</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">№</th>
                        <th>Стол</th>
                        <th>Гость</th>
                        <th>Телефон</th>
                        <th>Дата/время</th>
                        <th>Гостей</th>
                        <th>Статус</th>
                        <th class="text-end pe-3"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in reservations)
                    {
                        <tr>
                            <td class="ps-3">@r.ReservationID</td>
                            <td>@(r.Table?.Number ?? r.TableID)</td>
                            <td>@r.GuestName</td>
                            <td>@r.GuestPhone</td>
                            <td>@r.DateTime.ToLocalTime().ToString("dd.MM HH:mm")</td>
                            <td>@r.Persons</td>
                            <td><span class="badge bg-info">@GetReservationStatusLabel(r.Status)</span></td>
                            <td class="text-end pe-3">
                                @if ((AuthService.GetCurrentRole() is 1 or 2 or 6) && r.Status == "Active")
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => Cancel(r.ReservationID)">Отменить</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (showReserveModal)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Новое бронирование</h5>
                    <button type="button" class="btn-close" @onclick="() => showReserveModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small">Стол</label>
                        <select data-choice="true" class="form-select" @bind="reserveForm.TableID">
                            <option value="0">— выбрать —</option>
                            @foreach (var t in tables)
                            {
                                <option value="@t.TableID">Стол @t.Number</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3"><label class="form-label small">Имя гостя</label><input required minlength="2" data-kind="name" maxlength="80" class="form-control" @bind="reserveForm.GuestName" /></div>
                    <div class="mb-3"><label class="form-label small">Телефон</label><RestaurantBlazor.Shared.PhoneInput @bind-Value="reserveForm.GuestPhone" /></div>
                    <div class="row g-2">
                        <div class="col-7">
                            <label class="form-label small">Дата/время</label>
                            <input class="form-control" type="datetime-local" max="@DateTime.Now.AddYears(1).ToString("yyyy-MM-ddTHH:mm")"
                                   min="@DateTime.Now.AddMinutes(5).ToString("yyyy-MM-ddTHH:mm")"
                                   value="@reserveForm.DateTime.ToString("yyyy-MM-ddTHH:mm")"
                                   @onchange="OnDateChanged" />
                        </div>
                        <div class="col-5"><label class="form-label small">Гостей</label><input required max="@(tables.FirstOrDefault(t => t.TableID == reserveForm.TableID)?.Capacity ?? 30)" class="form-control" type="number" min="1" @bind="reserveForm.Persons" /></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showReserveModal = false">Отмена</button>
                    <button class="btn btn-warning" data-validate="true" @onclick="DoReserve">Забронировать</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<RestaurantTable> tables = new();
    private List<Reservation> reservations = new();
    private bool showReserveModal;
    private bool showCreateTable;
    private CreateTableRequest newTable = new();
    private ReservationRequest reserveForm = new() { DateTime = DateTime.Now.AddHours(1), Persons = 2 };

    private void OnDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
            reserveForm.DateTime = dt;
        else
            reserveForm.DateTime = DateTime.Now.AddHours(1);
    }
    private string errorMessage = "";
    private string successMessage = "";
    private string waiterNotification = "";

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        if (!AuthService.IsAuthenticated()) { Nav.NavigateTo("/", forceLoad: true); return; }
        if (AuthService.GetCurrentRole() is not (1 or 2 or 6)) { Nav.NavigateTo("/home", forceLoad: true); return; }
        HubService.OnWaiterNotification += OnWaiterNotification;
        HubService.OnTablesUpdated += OnTablesUpdated;
        await HubService.StartAsync();
        await HubService.JoinTableObserversAsync();
        await Load();
    }

    private void OnTablesUpdated() => InvokeAsync(Load);

    private async Task Load()
    {
        tables = await Api.GetTablesAsync();
        reservations = await Api.GetReservationsAsync();
    }

    private async Task CreateTable()
    {
        if (newTable.Number <= 0 || newTable.Capacity <= 0)
        { errorMessage = "Заполните корректно поля"; AutoHide(); return; }
        var r = await Api.CreateTableAsync(newTable);
        if (r?.Status == true)
        {
            successMessage = "Стол создан"; showCreateTable = false; newTable = new(); await Load();
        }
        else errorMessage = r?.Message ?? "Ошибка";
        AutoHide();
    }

    private async Task DeleteTable(int id)
    {
        var r = await Api.DeleteTableAsync(id);
        if (r?.Status == true) { successMessage = "Удалено"; await Load(); }
        else errorMessage = r?.Message ?? "Ошибка";
        AutoHide();
    }

    private async Task DoReserve()
    {
        if (reserveForm.TableID <= 0 || string.IsNullOrWhiteSpace(reserveForm.GuestName))
        { errorMessage = "Заполните все поля"; AutoHide(); return; }
        if (reserveForm.Persons < 1)
        { errorMessage = "Гостей должно быть не меньше 1"; AutoHide(); return; }
        if (reserveForm.DateTime <= DateTime.Now)
        { errorMessage = "Дата бронирования должна быть в будущем"; AutoHide(); return; }
        var r = await Api.CreateReservationAsync(reserveForm);
        if (r?.Status == true)
        {
            successMessage = "Бронирование создано"; showReserveModal = false;
            reserveForm = new() { DateTime = DateTime.Now.AddHours(1), Persons = 2 };
            await Load();
        }
        else errorMessage = r?.Message ?? "Ошибка";
        AutoHide();
    }

    private async Task Cancel(int id)
    {
        var r = await Api.CancelReservationAsync(id);
        if (r?.Status == true) { successMessage = "Отменено"; await Load(); }
        else errorMessage = r?.Message ?? "Ошибка";
        AutoHide();
    }

    private void AutoHide()
    {
        _ = Task.Delay(2500).ContinueWith(_ =>
        {
            errorMessage = ""; successMessage = "";
            InvokeAsync(StateHasChanged);
        });
    }


    private void OnWaiterNotification(string message)
    {
        waiterNotification = message;
        InvokeAsync(StateHasChanged);
        _ = Task.Delay(7000).ContinueWith(_ => { waiterNotification = ""; InvokeAsync(StateHasChanged); });
    }

    public ValueTask DisposeAsync()
    {
        HubService.OnWaiterNotification -= OnWaiterNotification;
        HubService.OnTablesUpdated -= OnTablesUpdated;
        return ValueTask.CompletedTask;
    }

    private string GetTableCardClass(string s) => s switch
    {
        "Free" => "border-start border-4 border-success",
        "Occupied" => "border-start border-4 border-warning",
        "Reserved" => "border-start border-4 border-info",
        _ => ""
    };

    private string GetTableStatusClass(string s) => s switch
    {
        "Free" => "bg-success",
        "Occupied" => "bg-warning text-dark",
        "Reserved" => "bg-info",
        _ => "bg-secondary"
    };

    private string GetTableStatusLabel(string s) => s switch
    {
        "Free" => "Свободен",
        "Occupied" => "Занят",
        "Reserved" => "Зарезервирован",
        _ => s
    };

    private string GetReservationStatusLabel(string s) => s switch
    {
        "Active" => "Активна",
        "Cancelled" => "Отменена",
        "Completed" => "Завершена",
        _ => s
    };
}

