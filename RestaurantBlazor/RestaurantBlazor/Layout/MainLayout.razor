@inherits LayoutComponentBase
@implements IDisposable
@inject RestaurantBlazor.Services.IAuthService AuthService
@inject NavigationManager Nav

<div class="page">
    <aside class="sidebar">
        <div class="brand">
            <img class="hearth-logo" src="img/ochag-mark.svg" alt="Логотип Очаг" />
            <div>
                <div class="brand-title">ОЧАГ</div>
                <div class="brand-sub">РЕСТОРАН</div>
            </div>
        </div>
        <div class="sidebar-label">ВАШ ОЧАГ</div>
        <NavMenu />
        <div class="sidebar-note"><span>С теплом к каждому.</span><small>Ресторан «Очаг» · Казань</small></div>
    </aside>

    <main>
        <header class="top-bar">
            <div class="brand-text">
                <span class="header-dot" aria-hidden="true"></span>
                <span>Ресторан «Очаг»</span>
            </div>
            @if (AuthService.IsAuthenticated())
            {
                <div class="user-info">
                    <span class="role-badge">@AuthService.GetRoleName()</span>
                    <span class="user-name">@AuthService.GetCurrentUserName()</span>
                    <button class="btn--ghost" @onclick="DoLogout">
                        <i class="bi bi-box-arrow-right me-1"></i>Выйти
                    </button>
                </div>
            }
        </header>

        <article class="content role-@AuthService.GetCurrentRole()">
            <div class="workspace-intro"><span>ОЧАГ <span aria-hidden="true">/</span> @AuthService.GetRoleName()</span><small>@WorkspaceHint</small></div>
            @Body
        </article>
    </main>
</div>
@if (AuthService.IsAuthenticated() && AuthService.GetCurrentRole() == 4)
{
    <SupportWidget />
}

<style>
    .page{display:block;min-height:100vh;width:100%;padding-left:244px;overflow-x:hidden;background:#30231d}
    .page>.sidebar{box-sizing:border-box;width:244px;min-width:244px;position:fixed;inset:0 auto 0 0;height:100vh;max-height:100vh;display:flex;flex-direction:column;overflow:hidden;background:#30231d;color:#f4e4cc;padding:0 14px 82px;border:0;z-index:1050}
    .sidebar .brand{display:flex;align-items:center;justify-content:flex-start;gap:14px;min-height:82px;padding:12px 10px 14px;border-bottom:1px solid #ffffff18}
    .sidebar .hearth-logo{display:block;width:44px;height:50px;flex:0 0 44px;object-fit:contain}
    .sidebar .brand-title{font-family:Georgia,'Times New Roman',serif;font-size:25px;letter-spacing:4px;color:#fff0d7;line-height:1.1}
    .sidebar .brand-sub{font-size:8px;letter-spacing:3px;color:#c49b6d;margin-top:6px}
    .sidebar .sidebar-label{font-size:9px;letter-spacing:2.5px;color:#ae947c;padding:15px 12px 7px}
    .sidebar .nav-wrap{display:flex;flex:1 1 auto;min-height:0;flex-direction:column;gap:3px;padding:0}
    .sidebar .nav-btn{display:flex;flex:0 0 40px;align-items:center;gap:10px;width:100%;min-height:40px;padding:8px 10px;text-align:left;background:transparent;border:1px solid transparent;border-radius:9px;color:#d7c7b3;font-size:12px;font-weight:600;cursor:pointer}
    .sidebar .nav-btn i{width:21px;font-size:18px;color:#c49b6d}
    .sidebar .nav-btn:hover{background:#ffffff0b;color:#fff4e3}
    .sidebar .nav-btn.nav-active{background:#ad5a35;color:#fff8e9;border-color:#c3764b}
    .sidebar .sidebar-note{position:absolute;left:27px;bottom:16px;width:195px;margin:0;padding:0;color:#e3ba88;z-index:10}
    .sidebar .sidebar-note span{display:block;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-size:17px}
    .sidebar .sidebar-note small{display:block;color:#ac937c;font-size:10px;margin-top:7px}
    .page>main{display:block;width:100%;min-width:0;min-height:100vh;overflow-x:hidden;background:#f3eee5}
    .guest-welcome{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(240px,.75fr);align-items:center;min-height:320px;margin:0 0 34px;border-radius:14px;overflow:hidden;background:#493023;color:#f8e7c9;position:relative}
    .guest-welcome>div{min-width:0;padding:36px 40px}
    .guest-welcome .eyebrow{color:#daa76e;font-size:10px;letter-spacing:2px}
    .guest-welcome h1{font-family:Georgia,'Times New Roman',serif;font-weight:400;color:#ffedce;font-size:42px;line-height:1.1;margin:16px 0}
    .guest-welcome p{font-size:13px;color:#e0c8a8;max-width:390px;margin-bottom:25px}
    .guest-welcome>img{display:block;width:100%;height:320px;max-height:320px;object-fit:cover;object-position:center 65%;mask-image:linear-gradient(to right,transparent,#000 20%)}
    .loyalty-overview{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:0 0 30px}
    .loyalty-overview article{background:#fffdf7;border:1px solid #e2d6c4;border-radius:12px;padding:18px}
    .loyalty-overview h3{font-size:14px;margin:0 0 6px;color:#70452c}
    .loyalty-overview p{font-size:12px;color:#806e5e;margin:0}
    .workspace-intro{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 24px;padding:0 0 13px;border-bottom:1px solid #ddceb7;color:#9d7551}
    .workspace-intro>span{font-size:9px;letter-spacing:2px;text-transform:uppercase}
    .workspace-intro small{font-family:Georgia,'Times New Roman',serif;font-size:13px;font-style:italic;color:#92775a;text-align:right}
    @@media(max-width:800px){.page{padding-left:0}.page>.sidebar{position:relative;inset:auto;width:100%;min-width:0;height:auto;max-height:none;padding:0 14px 12px;z-index:auto}.sidebar .brand{min-height:76px;padding:10px}.sidebar .sidebar-label,.sidebar .sidebar-note{display:none}.sidebar .nav-wrap{flex:none;min-height:0;flex-direction:row;flex-wrap:wrap}.sidebar .nav-btn{flex:0 0 auto;width:auto;min-height:38px;padding:7px 10px}.guest-welcome{grid-template-columns:minmax(0,1fr) 150px;min-height:250px}.guest-welcome>div{padding:22px 18px}.guest-welcome h1{font-size:30px}.guest-welcome>img{height:250px;max-height:250px}.loyalty-overview{grid-template-columns:1fr}.workspace-intro small{max-width:55%}}
</style>

@code {
    private string WorkspaceHint => AuthService.GetCurrentRole() switch
    {
        1 => "Всё, что помогает ресторану быть домом",
        2 => "Внимание к гостям — в каждой детали",
        3 => "Хороший вкус начинается с вашей заботы",
        4 => "Ваш стол уже ждёт тёплых встреч",
        5 => "Доставляем тепло к каждому порогу",
        6 => "Рядом, чтобы помочь каждому гостю",
        7 => "Хорошие блюда начинаются с хороших продуктов",
        _ => "Хороший день начинается с тепла"
    };
    protected override async Task OnInitializedAsync()
    {
        AuthService.Changed += OnAuthChanged;
        if (!AuthService.IsAuthenticated())
            await AuthService.InitializeAsync();
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    private async Task DoLogout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/", forceLoad: true);
    }

    public void Dispose() => AuthService.Changed -= OnAuthChanged;
}
