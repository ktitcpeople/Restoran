@inject NavigationManager Nav
@inject RestaurantBlazor.Services.IAuthService AuthService
@implements IDisposable

<div class="nav-wrap">
    @if (AuthService.IsAuthenticated())
    {
        var role = AuthService.GetCurrentRole();
        var cur = Nav.Uri;

        @if (role == 6)
        {
            <button class="nav-btn @(cur.Contains("/tables") ? "nav-active" : "")" @onclick='() => Go("/tables")'>
                <i class="bi bi-calendar-check"></i><span>Бронирования</span>
            </button>
            <button class="nav-btn @(cur.Contains("/support-operator") ? "nav-active" : "")" @onclick='() => Go("/support-operator")'>
                <i class="bi bi-headset"></i><span>Очередь поддержки</span>
            </button>
        }
        else
        {
            @if (role == 4)
            {
                <button class="nav-btn @(cur.EndsWith("/guest-home") ? "nav-active" : "")" @onclick='() => Go("/guest-home")'>
                    <i class="bi bi-grid-1x2-fill"></i><span>Главная</span>
                </button>
                <button class="nav-btn @(cur.EndsWith("/guest") ? "nav-active" : "")" @onclick='() => Go("/guest")'>
                    <i class="bi bi-cup-hot"></i><span>Зал гостя</span>
                </button>
            }
            else if (role == 7)
            {
                <button class="nav-btn @(cur.Contains("/supplier") ? "nav-active" : "")" @onclick='() => Go("/supplier")'>
                    <i class="bi bi-box-seam"></i><span>Заявки на поставку</span>
                </button>
            }
            else
            {
                <button class="nav-btn @(cur.EndsWith("/home") ? "nav-active" : "")" @onclick='() => Go("/home")'>
                    <i class="bi bi-grid-1x2-fill"></i><span>Главная</span>
                </button>
            }

        @if (role == 1 || role == 2)
        {
            <button class="nav-btn @(cur.Contains("/orders") ? "nav-active" : "")" @onclick='() => Go("/orders")'>
                <i class="bi bi-receipt-cutoff"></i><span>Заказы</span>
            </button>
            <button class="nav-btn @(cur.Contains("/tables") ? "nav-active" : "")" @onclick='() => Go("/tables")'>
                <i class="bi bi-grid-3x3-gap-fill"></i><span>Столы</span>
            </button>
        }

        @if (role == 1 || role == 3)
        {
            <button class="nav-btn @(cur.Contains("/kitchen") ? "nav-active" : "")" @onclick='() => Go("/kitchen")'>
                <i class="bi bi-fire"></i><span>Кухня</span>
            </button>
        }

        @if (role == 1)
        {
            <button class="nav-btn @(cur.Contains("/staff") ? "nav-active" : "")" @onclick='() => Go("/staff")'>
                <i class="bi bi-people-fill"></i><span>Персонал</span>
            </button>
            <button class="nav-btn @(cur.Contains("/menu") ? "nav-active" : "")" @onclick='() => Go("/menu")'>
                <i class="bi bi-card-list"></i><span>Меню</span>
            </button>
            <button class="nav-btn @(cur.Contains("/inventory") ? "nav-active" : "")" @onclick='() => Go("/inventory")'>
                <i class="bi bi-box-seam"></i><span>Склад</span>
            </button>
            <button class="nav-btn @(cur.Contains("/reports") ? "nav-active" : "")" @onclick='() => Go("/reports")'>
                <i class="bi bi-graph-up-arrow"></i><span>Отчёты</span>
            </button>
        }

        @if (role == 1 || role == 5)
        {
            <button class="nav-btn @(cur.Contains("/delivery") ? "nav-active" : "")" @onclick='() => Go("/delivery")'>
                <i class="bi bi-truck"></i><span>Доставка</span>
            </button>
        }

        @if (role == 4)
        {
            <button class="nav-btn @(cur.Contains("/menu") ? "nav-active" : "")" @onclick='() => Go("/menu")'>
                <i class="bi bi-card-list"></i><span>Меню</span>
            </button>
        }
        }
    }
</div>

@code {
    void Go(string url) => Nav.NavigateTo(url);

    protected override void OnInitialized()
    {
        AuthService.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        AuthService.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
