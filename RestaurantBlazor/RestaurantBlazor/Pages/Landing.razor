@page "/"
@layout EmptyLayout
@using RestaurantBlazor.Services
@using RestaurantBlazor.Models
@inject IAuthService Auth
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>Ресторан «Очаг»</PageTitle>

<style>
    .landing-page{--ink:#39291f;--muted:#816b59;--paper:#f6f1e8;--line:#e4d8c5;--accent:#a7472a;--gold:#e9b975;background:var(--paper);color:var(--ink);min-height:100vh;font-family:Inter,Arial,sans-serif}
    .landing-page *{box-sizing:border-box}
    .landing-nav{max-width:1240px;min-height:82px;margin:auto;padding:14px 28px;display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid var(--line)}
    .landing-brand{display:flex;align-items:center;gap:11px;color:var(--ink);text-decoration:none;flex:none}
    .landing-brand .hearth-logo{width:38px;height:42px;object-fit:contain;border-radius:50%;background:#f0dfc2;padding:5px}
    .landing-brand strong{display:block;font-family:Georgia,serif;font-size:23px;letter-spacing:3px;font-weight:500;line-height:1.1}
    .landing-brand small{display:block;margin-top:4px;color:#9a6d4d;font-size:8px;letter-spacing:1.4px}
    .landing-nav nav{display:flex;align-items:center;gap:24px}
    .landing-nav nav a,.text-action{color:#6e5947;text-decoration:none;font-size:12px}
    .landing-nav nav a:hover,.text-action:hover{color:var(--accent)}
    .landing-login{border:1px solid #cbb294;background:transparent;border-radius:5px;padding:10px 15px;color:#69432d;font-size:12px}
    .landing-hero{max-width:1240px;min-height:510px;margin:auto;padding:52px 38px 48px;display:grid;grid-template-columns:minmax(0,0.9fr) minmax(360px,1.1fr);gap:52px;align-items:center}
    .hero-copy{max-width:510px}
    .hero-copy .eyebrow{color:#a45f3a;font-size:10px;letter-spacing:1.6px;font-weight:700}
    .hero-copy h1{margin:20px 0;font-family:Georgia,serif;font-size:clamp(44px,5vw,68px);font-weight:400;line-height:1.03;letter-spacing:-1.5px;color:#442f21}
    .hero-copy h1 em{color:var(--accent);font-weight:400}
    .hero-copy>p{max-width:410px;color:var(--muted);font-size:15px;line-height:1.75}
    .hero-actions{display:flex;align-items:center;gap:22px;margin-top:26px}
    .primary-action{border:0;border-radius:5px;background:var(--accent);color:white;padding:14px 19px;font-weight:600;font-size:13px}
    .primary-action:hover{background:#843b25}
    .hero-art{position:relative;justify-self:end;width:min(100%,520px);height:410px;min-height:0;margin:0;overflow:hidden;border-radius:220px 220px 8px 8px;background:#6b422b;box-shadow:0 18px 42px #55351d24}
    .hearth-scene{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 55%}
    .hero-art:after{content:"";position:absolute;inset:45% 0 0;background:linear-gradient(transparent,#21160fd9);pointer-events:none}
    .hero-art-caption{position:absolute;z-index:1;left:24px;bottom:20px;color:#fff0d8}
    .hero-art-caption span{font-size:9px;letter-spacing:2px;color:#edc997}
    .hero-art-caption strong{display:block;margin-top:6px;font-family:Georgia,serif;font-weight:400;font-size:23px;line-height:1.2}
    .hero-seal{position:absolute;z-index:2;right:12px;bottom:18px;width:82px;height:82px;display:grid;place-content:center;text-align:center;border-radius:50%;background:var(--gold);color:#5c4028;font-size:9px;line-height:1.7;letter-spacing:1px;transform:rotate(8deg)}
    .landing-highlights{max-width:1164px;margin:0 auto;padding:24px 28px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
    .landing-highlights article{display:flex;align-items:flex-start;gap:13px;padding:5px 13px}
    .highlight-icon{color:#a36539;font-size:23px}
    .landing-highlights h3{margin:0 0 5px;font-family:Georgia,serif;font-size:19px;font-weight:400;color:#624024}
    .landing-highlights p{margin:0;color:var(--muted);font-size:11px;line-height:1.6}
    .locations-section{max-width:1240px;margin:auto;padding:64px 38px 72px}
    .section-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:24px}
    .section-heading h2{margin:8px 0 0;font-family:Georgia,serif;font-size:39px;font-weight:400;color:#4c3220}
    .section-heading>p{margin:0 0 5px;color:var(--muted);font-size:12px}
    .location-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
    .location-card{min-height:104px;padding:17px;display:flex;align-items:center;gap:14px;position:relative;border:1px solid var(--line);border-radius:6px;background:#fbf8f2;color:#5a3c26;text-decoration:none}
    .location-card:hover{background:#efe2cd;color:#5a3c26}
    .location-number{font-family:Georgia,serif;font-size:27px;color:#bb9061}
    .location-card h3{margin:0 18px 5px 0;font-size:12px;font-weight:600}
    .location-card p{margin:0;color:#8c735a;font-size:10px}
    .location-card small{display:inline-block;margin-top:6px}
    .location-arrow{position:absolute;right:12px;top:12px;font-size:12px}
    .landing-page .landing-footer{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:30px;align-items:center;padding:28px max(calc((100vw - 1164px)/2),38px);background:#eadcc6!important;color:#39291f!important}
    .landing-page .landing-footer .landing-brand,.landing-page .landing-footer .landing-brand strong{color:#39291f!important}
    .landing-page .landing-footer .landing-brand small{color:#755b43!important}
    .landing-page .landing-footer>div>p{margin:8px 0 0;color:#604a39!important;font-size:12px}
    .landing-page .footer-contact{display:grid;gap:5px;font-size:11px}
    .landing-page .footer-contact span{color:#805b3a!important;font-size:9px;letter-spacing:1px}
    .landing-page .footer-contact strong{color:#39291f!important;font-weight:600}
    .landing-page .footer-contact a{color:#913b2c!important;text-decoration:none}
    @@media(max-width:800px){.landing-nav{padding:12px 18px}.landing-nav nav{display:none}.landing-hero{grid-template-columns:1fr;gap:25px;padding:38px 22px}.hero-art{justify-self:center;width:min(100%,520px);height:340px}.landing-highlights{grid-template-columns:1fr;gap:12px;padding:20px}.landing-highlights article{border:0!important;padding:4px}.locations-section{padding:42px 20px}.location-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.landing-footer{grid-template-columns:1fr 1fr;padding:24px 20px}.landing-footer>div:first-child{grid-column:1/-1}}
    @@media(max-width:520px){.landing-login{padding:9px 10px;font-size:11px}.hero-copy h1{font-size:46px}.hero-copy>p{font-size:14px}.hero-actions{gap:15px;flex-wrap:wrap}.hero-art{height:285px}.section-heading{display:block}.section-heading>p{margin-top:10px}.section-heading h2{font-size:32px}.location-grid{grid-template-columns:1fr}.landing-footer{grid-template-columns:1fr}.landing-footer>div:first-child{grid-column:auto}}
</style>

<div class="landing-page">
    <header class="landing-nav">
        <a class="landing-brand" href="/" aria-label="Ресторан Очаг">
            <img class="hearth-logo" src="img/ochag-mark.svg" alt="" />
            <span><strong>ОЧАГ</strong><small>РЕСТОРАН · ТЁПЛЫЕ ВСТРЕЧИ</small></span>
        </a>
        <nav><a href="#about">О ресторане</a><a href="#hours">Часы работы</a><a href="#locations">Адреса</a><a href="#contacts">Контакты</a></nav>
        <button class="landing-login" @onclick="OpenApp">@(Auth.IsAuthenticated() ? "Личный кабинет" : "Войти") <i class="bi bi-arrow-right"></i></button>
    </header>

    <main>
        <section class="landing-hero">
            <div class="hero-copy">
                <span class="eyebrow"><i class="bi bi-fire"></i> РЕСТОРАН ТЁПЛЫХ ВСТРЕЧ · КАЗАНЬ</span>
                <h1>Место, где<br />становится <em>теплее.</em></h1>
                <p>Живой огонь, любимые блюда и долгие разговоры. Собираемся за одним столом — как дома.</p>
                <div class="hero-actions"><button class="primary-action" @onclick="OpenApp">Открыть меню <i class="bi bi-arrow-up-right"></i></button><a class="text-action" href="#locations">Наши адреса <i class="bi bi-arrow-down"></i></a></div>
            </div>
            <div class="hero-art">
                <img src="img/hearth-scene.svg" alt="Тёплый свет очага, ужин и свеча на деревянном столе" class="hearth-scene" />
                <div class="hero-art-caption"><span>ОЧАГ / КАЗАНЬ</span><strong>У каждого тепла<br />есть свой адрес.</strong></div>
                <span class="hero-seal">СОБИРАЕМ<br />БЛИЗКИХ</span>
            </div>
        </section>

        <section class="landing-highlights" id="about">
            <article><span class="highlight-icon"><i class="bi bi-egg-fried"></i></span><div><h3>Еда с душой</h3><p>Любимые блюда, приготовленные с заботой.</p></div></article>
            <article id="hours"><span class="highlight-icon"><i class="bi bi-clock"></i></span><div><h3>Мы открыты</h3><p>Пн–Чт · 12:00–23:00<br />Пт–Вс · 12:00–24:00</p></div></article>
            <article><span class="highlight-icon"><i class="bi bi-geo-alt"></i></span><div><h3>Рядом с вами</h3><p>Наши рестораны в Казани.</p></div></article>
        </section>

        <section class="locations-section" id="locations">
            <div class="section-heading"><div><span class="eyebrow">РЕСТОРАН «ОЧАГ»</span><h2>Ваш «Очаг» рядом</h2></div><p>Семь адресов. Одно чувство дома.</p></div>
            <div class="location-grid">
                @foreach (var place in locations)
                {
                    <a class="location-card" href="@MapUrl(place.Address)" target="_blank" rel="noopener noreferrer" aria-label="Открыть @place.Name на карте"><span class="location-number">@place.BranchID.ToString("00")</span><div><h3>@place.Name</h3><p><i class="bi bi-geo-alt"></i> @place.Address</p><small class="text-danger">Открыть на карте</small></div><i class="bi bi-arrow-up-right location-arrow"></i></a>
                }
            </div>
        </section>
    </main>

    <footer class="landing-footer" id="contacts">
        <div><a class="landing-brand" href="/"><img class="hearth-logo" src="img/ochag-mark.svg" alt="" /><span><strong>ОЧАГ</strong><small>РЕСТОРАН · КАЗАНЬ</small></span></a><p>Вкусные встречи в тёплой атмосфере.</p></div>
        <div class="footer-contact"><span>ЧАСЫ РАБОТЫ</span><strong>Пн–Чт 12:00–23:00</strong><strong>Пт–Вс 12:00–24:00</strong></div>
        <div class="footer-contact"><span>РЕСТОРАН «ОЧАГ»</span><strong>Казань</strong><a href="#locations">Наши адреса</a></div>
    </footer>
</div>



@code {
    private List<BranchDto> locations = new();
    private static string MapUrl(string address) => $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(address)}";

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        locations = await Api.GetBranchesAsync();
    }

    private void OpenApp()
    {
        if (!Auth.IsAuthenticated()) { Nav.NavigateTo("/login"); return; }
        Nav.NavigateTo(Auth.GetCurrentRole() switch { 4 => "/guest-home", 6 => "/support-operator", 7 => "/supplier", _ => "/home" });
    }
}
